# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — Project Settings > API > service_role secret.
# Server-only, needed for account deletion (auth.admin.deleteUser). Never
# expose this to the client or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Pokemon TCG (fallback when RAPIDAPI_KEY is not set)
POKEMON_TCG_API_KEY=

# TCGGO via RapidAPI (primary price lookup)
RAPIDAPI_KEY=

